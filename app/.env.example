# Where the backend reads the OSSBridge result tables from.
#
# A local results folder (filled by the pipeline, or downloaded with
#   python -m ossbridge_pipeline.publish --download).
# Relative paths are resolved from this app/ folder. Default: the repo's data/results.
RESULTS_DIR=../data/results

# Or the published Hugging Face dataset (no download needed); this replaces RESULTS_DIR:
# RESULTS_PATH=hf://datasets/rachna1508/ossbridge-results/results

# Where the backend reads the dependents index from: its summaries list every library
# and version on Maven Central (analyzed or not). Without it the app lists only the
# analyzed versions. A local index folder (python -m ossbridge_pipeline.publish --download):
INDEX_DIR=../data/dependents-index

# Or the published Hugging Face dataset; this replaces INDEX_DIR:
# INDEX_PATH=hf://datasets/rachna1508/ossbridge-results/dependents-index
