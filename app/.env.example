# Settings for running the app on your computer with Docker.
# Copy this file to .env in this app folder, change what you need, and start the app.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Then open http://localhost:3000 in your browser.
# Git ignores the .env file, so your token is never committed.


# Results
# The app reads the published results from Hugging Face by default.
# This needs no download and shows every analyzed library version.
RESULTS_PATH=hf://datasets/rachna1508/ossbridge-results/results

# The dependents index lists every library and version on Maven Central, analyzed or not.
# Without it the app lists only the analyzed versions.
INDEX_PATH=hf://datasets/rachna1508/ossbridge-results/dependents-index

# To read local folders instead, comment out the two lines above and uncomment these.
# Relative paths start from this app folder.
# The pipeline fills these folders. To download the published ones, see
# "Use a local copy of the data" in the README.
# RESULTS_DIR=../data/results
# INDEX_DIR=../data/dependents-index


# Analyze button
# The app shows an Analyze button for versions that have not been analyzed yet.
# The button only appears when you set a GitHub token here.
# Pressing it starts a real analysis on GitHub Actions, which publishes its results.
#
# Create the token at https://github.com/settings/personal-access-tokens/new
# Give it access to this repository only, with the permission Actions set to Read and write.
# Leave this empty to use the app without the Analyze button.
GITHUB_TOKEN=
