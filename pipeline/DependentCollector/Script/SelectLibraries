import requests
from dotenv import main
import os
import json
import pandas as pd

# Replace 'YOUR_API_KEY' with your actual Libraries.io API key
api_key = 'YOUR_API_KEY'
print(api_key)
url = 'https://libraries.io/api/search'

# Define the parameters for the first request
params = {
    'platforms': 'Maven',
    'sort': 'rank',  # Sort by the number of dependent repositories
    'order': 'desc',  # Descending order
    'api_key': api_key,  # Your API key
    'per_page': 50,  # Number of results per page
    'page': 1  # Only fetch the first page
}

# Fetch the top 50 libraries
response = requests.get(url, params=params)

# Check if the request was successful
if response.status_code == 200:
    data = response.json()

    # Print the results
    for library in data:
        print(f"Library: {library['name']}, Dependents: {library['dependent_repos_count']}, Latest Release: {library['latest_release_number']}")

    # Save results to a JSON file
    file_path = os.path.join('popular_libraries.json')
    with open(file_path, 'w') as json_file:
        json.dump(data, json_file, indent=4)

    # Prepare data for CSV
    maven_projects = []
    for library in data:
        maven_projects.append({
            "name": library['name'],
            "platform": library['platform'],
            "rank": library['rank'],
            "stars": library['stars'],
            "forks": library['forks'],
            "dependents_count": library['dependents_count'],
            "dependent_repos_count": library['dependent_repos_count'],
            "licenses": library['licenses'],
            "repository_url": library['repository_url'],
            "package_manager_url": library['package_manager_url'],
            "latest_download_url": library['latest_download_url'],
            "versions": library['versions'],
        })

    # Define file path for CSV
    filename = './Data/Top50Libraries.csv'

    # Check if file exists and if it's corrupted
    if os.path.isfile(filename):
        try:
            pd.read_csv(filename)  # Attempt to read the file to check if it's valid
        except Exception as e:
            print(f"Error reading existing CSV file: {e}. The file will be replaced.")
            os.remove(filename)  # Remove the corrupted file
            mode = 'w'
        else:
            mode = 'a'  # File is valid, append to it
    else:
        mode = 'w'  # File does not exist, create a new one

    # Write the DataFrame to the CSV file
    with open(filename, mode=mode, newline='') as f:
        pd.DataFrame(maven_projects).to_csv(f, index=False)

else:
    print(f"Failed to retrieve data: {response.status_code}")